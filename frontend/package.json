{
  "name": "rocokingdom-recognizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "postbuild": "node scripts/copy-to-static.mjs",
    "export:web:recog": "node ../tools/export_web_recognizer.mjs --prune --eval off",
    "export:web:recog:auto": "node ../tools/export_web_recognizer.mjs --prune --eval auto",
    "export:web:recog:eval": "node ../tools/export_web_recognizer.mjs --prune --eval force",
    "build:web": "npm run export:web:icons && npm run export:web:recog && vite build --mode web",
    "export:web:icons": "node scripts/export_web_icons.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "onnxruntime-web": "^1.20.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
